# =============================================================================
# Zolo — environment configuration
# Copy this file to .env.local and fill in the values you have. The app runs
# with realistic mock data even if every one of these is left blank — see
# README.md "Running without credentials" for what degrades and how.
# =============================================================================

# --- App -----------------------------------------------------------------
# Public base URL of the deployed app. Used for metadata/OG tags and Stripe
# redirect URLs. Defaults to http://localhost:3000 in dev.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (auth, database, storage) -----------------------------------
# Create a project at https://supabase.com, then Project Settings > API.
# Without these, auth is disabled and the app runs on the in-memory mock
# catalog only (browsing works, sign-in does not).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — SERVER-ONLY, bypasses Row Level Security. Never expose
# this to the client or commit it. Used by webhooks, admin routes, and
# scripts/seed-supabase.ts.
SUPABASE_SERVICE_ROLE_KEY=

# Email of the account that should have admin dashboard access (/admin).
# Alternatively set app_metadata.role = "admin" on a user in Supabase Auth.
ADMIN_EMAIL=

# --- Anthropic (AI recommendations, Surprise Me, Weekend Planner) --------
# Get a key at https://console.anthropic.com. Without it, the app falls
# back to the deterministic hybrid scorer with template-based reasoning —
# every AI-labeled feature keeps working, just without natural-language
# personalization.
ANTHROPIC_API_KEY=
# Optional override; defaults to a current Claude model.
ANTHROPIC_MODEL=claude-sonnet-5

# --- Stripe (subscriptions) ------------------------------------------------
# Get keys at https://dashboard.stripe.com/apikeys. Without these, the
# Premium upgrade button shows a clear "billing not configured" message
# instead of crashing.
STRIPE_SECRET_KEY=
# From the Stripe CLI (`stripe listen`) in dev, or your webhook endpoint's
# signing secret in production.
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Price ID for the $19.99/mo Premium plan (Stripe Dashboard > Product catalog).
NEXT_PUBLIC_STRIPE_PREMIUM_PRICE_ID=
# Display-only price shown before checkout loads; keep in sync with Stripe.
NEXT_PUBLIC_PREMIUM_PRICE=19.99

# --- Maps / Places (geocoding) --------------------------------------------
# Google Cloud Console > APIs & Services > Credentials. Enable the
# Geocoding API. Without it, onboarding's city search uses a small built-in
# list of major cities instead of live geocoding.
MAPS_API_KEY=
# Optional: a custom MapLibre style URL for the interactive Map page.
# Defaults to the free OpenFreeMap "liberty" style (no key required).
NEXT_PUBLIC_MAP_STYLE_URL=

# --- Events (future real-time events provider) -----------------------------
# Not yet wired to a live provider — the Events surface currently reads from
# the same experience catalog (see src/services/providers/events-provider.ts).
# Set this and implement a real provider there to go live with e.g.
# Eventbrite or Ticketmaster.
EVENT_API_KEY=

# --- Resend (contact form email, and Supabase Auth's custom SMTP) ----------
# Get a key at https://resend.com/api-keys. Used by /api/contact to send
# messages to ADMIN_EMAIL. Without it, the contact form silently no-ops
# instead of crashing (see src/lib/email/send.ts).
RESEND_API_KEY=

# --- Sentry (error monitoring) ----------------------------------------------
# Get a DSN at https://sentry.io by creating a Next.js project. Without it,
# errors are simply not reported anywhere — the app itself is unaffected.
NEXT_PUBLIC_SENTRY_DSN=
